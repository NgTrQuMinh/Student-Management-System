# ===== Máy chủ =====
NODE_ENV=development
PORT=3000
HOST=localhost
TRUST_PROXY=false

# ===== MongoDB =====
# Cách 1: dùng chuỗi kết nối đầy đủ (khuyến nghị)
MONGODB_URI=mongodb://127.0.0.1:27017/student_management
MONGODB_DB_NAME=student_management

# Cách 2: nếu dùng MongoDB Atlas và muốn tách tài khoản
# MONGODB_USER=<user>
# MONGODB_PASS=<pass>

# ===== CORS =====
# Danh sách origin cách nhau dấu phẩy, hoặc * cho tất cả
CORS_ORIGIN=*

# ===== JWT & mật khẩu =====
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ===== Tài khoản admin (dùng cho: npm run create-admin) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-admin

# ===== Rate limit =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
